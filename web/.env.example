# Set these in Vercel (Project > Settings > Environment Variables), or in web/.env.local to run locally.
# The matchup database (same Neon database the pipeline writes to). Read-only access is enough.
DATABASE_URL=postgresql://user:password@host/matchup?sslmode=require
# The one admin password for the site.
ADMIN_PASSWORD=
# Optional: a long random string that signs login cookies (defaults to one derived from ADMIN_PASSWORD).
SESSION_SECRET=

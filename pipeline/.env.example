# Neon connection string for the matchup database (Neon console -> Connect, pooled or direct).
DATABASE_URL=postgresql://user:password@host/matchup?sslmode=require
# Read-only connection to the player ID registry database (used for names / roster / team mapping).
REGISTRY_DATABASE_URL=postgresql://readonly_user:password@host/neondb?sslmode=require

# Your team code, used by `python -m matchup publish` (e.g. the code shown in reports)
# HOME_TEAM=
